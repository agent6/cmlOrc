# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=0
TZ=UTC

# Background worker
# 1 = run the health/lease worker in-process (during gunicorn or runserver)
# 0 = do not run it in this process (use manage.py runhealthworker instead)
RUN_BACKGROUND_WORKER=0

# Health check defaults (also configurable at /settings/health/)
HEALTH_CHECK_INTERVAL=30
HEALTH_SCHEDULER_TICK=1
HEALTH_CHECK_HTTP_TIMEOUT=12
HEALTH_CHECK_BACKOFF_BASE=15
HEALTH_CHECK_BACKOFF_MAX=300

# Lab import timeout (seconds)
IMPORT_HTTP_TIMEOUT=8

